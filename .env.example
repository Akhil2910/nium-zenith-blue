# Copy to .env and fill in with YOUR OWN backend (local Supabase, self-hosted
# Supabase on AWS, or a managed Postgres+Supabase stack). Nothing here points
# at Lovable — the app talks only to the URL/key you set below.

# Browser-visible (inlined at build time)
VITE_SUPABASE_URL="http://localhost:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_PROJECT_ID="local"

# Server-side fallbacks used during SSR (same values)
SUPABASE_URL="http://localhost:54321"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"
SUPABASE_PROJECT_ID="local"

# Server-only. Never expose to the browser. Needed only for admin/maintenance work.
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
